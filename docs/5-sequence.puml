@startuml
actor Покупатель as U
participant "Веб-интерфейс" as W
participant "М4 Заказы" as O
database "База данных" as D
U -> W: Подтвердить корзину
W -> O: Данные и ключ запроса
O -> D: BEGIN; проверить остаток
D --> O: Результат проверки
alt товара достаточно
O -> D: Заказ + резерв; COMMIT
D --> O: Номер и сумма
O --> W: Заказ «Новый»
W --> U: Показать номер заказа
else товара недостаточно
O -> D: ROLLBACK
O --> W: Сообщение о нехватке
W --> U: Предложить изменить корзину
end
@enduml
